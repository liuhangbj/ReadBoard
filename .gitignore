# macOS / 编辑器
.DS_Store

# 临时备份 / SwiftPM 内部元数据
*.bak
.v-old.bak
.swiftpm/
**/.swiftpm/
.workbuddy/
podcast_field_content_diff.md
podcast_field_diff_report.json

# 运行时数据必须位于 ~/Library/Application Support/ReadBoard
Data/
Runtime/
archive/
*.db
*.db-shm
*.db-wal
*.db.bak.*
secrets.json
.env
.env.*

# 构建产物
.build/
**/.build/
*.app/
*.dmg
*.xcarchive/
.artifacts/
dist/

# node 依赖（engine 的 package.json 进 git，node_modules 首次 npm install 重建）
**/node_modules/
**/__pycache__/
*.pyc

# 签名与公证凭证永不入库
*.p12
*.cer
*.key
*.mobileprovision
*.provisionprofile

# Original screenshots (optimized versions are tracked)
docs/screenshots/*.png
!docs/screenshots/optimized/
